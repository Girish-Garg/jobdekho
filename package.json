{
  "name": "jobdekho",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/server/src/server.js",
    "dev:web": "npm -w @jobdekho/web run dev",
