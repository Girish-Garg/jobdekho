{
  "name": "jobdekho",
  "version": "0.2.3",
  "author": "Girish Garg",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node apps/server/src/server.js",
    "dev:web": "npm -w @jobdekho/web run dev",
    "test": "vitest run",
    "scrape": "node apps/scraper/src/index.js",
    "build": "npm -w @jobdekho/web run build",
    "pack:npm": "node scripts/npm-package/stage.js",
    "train:model": "node --max-old-space-size=8192 scripts/model/train.js",
    "review:model": "node scripts/model/review/server.js",
    "resume:check": "node apps/server/src/resume/check-templates.js"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
