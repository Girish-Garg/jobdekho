# JobDekho configuration. Copy to .env and edit. .env is gitignored and must
# stay that way. Every value here has a working default, so a fresh clone
# runs with no .env at all.

# --- Storage ---
# Where the corpus and your own files are kept. Relative to the working
# directory, so `npm start` and `npm run scrape` from the repo root share one
# corpus without either being told where it is. Created on first use.
JOBDEKHO_DATA_DIR=data

# --- Server ---
PORT=3000
# The app answers on this machine only. There is no sign-in, so anything
# that can reach the port can read your profile and resume and spend your
# own CLI subscription. Set 0.0.0.0 only if you mean to serve your network.
HOST=127.0.0.1
# development honours DEV_AUTH_USER_ID below. production requires
# SESSION_SECRET and ignores it, so the local identity cannot be switched on
# by accident on a deployed box.
NODE_ENV=development
# Signs the session cookie. Any long random string. Required in production;
# defaults to an insecure value in development.
SESSION_SECRET=dev-insecure-secret

# --- Identity ---
# JobDekho runs as one local person: there is no login screen and nothing to
# sign in to. Every request runs as this one user id. Any string works.
DEV_AUTH_USER_ID=local

# --- Telegram (scraper alerts, optional) ---
# Bot token from @BotFather; chat id from @userinfobot or the bot's getUpdates.
# Point these at a fresh database and the first run treats every posting as
# new, so it will send the full cap of alerts at once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Adzuna (optional aggregator; needs API credentials) ---
# A licensed aggregator that indexes Naukri, Indeed, Monster and TimesJobs.
# Free registration at developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
