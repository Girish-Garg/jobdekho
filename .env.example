# JobDekho configuration. Copy to .env and edit. .env is gitignored and must
# stay that way. DATABASE_URL is the only value without a usable default.

# --- Database ---
# Any Postgres 15 or newer. The schema is created and brought up to date by
# `npm run db:migrate`, which is safe to re-run.
DATABASE_URL=postgres://jobdekho:jobdekho@localhost:5432/jobdekho

# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000
# development keeps the session cookie usable over plain http://localhost and
# honours DEV_AUTH_USER_ID. production requires SESSION_SECRET and ignores
# the bypass, so it cannot be switched on by accident on a deployed box.
NODE_ENV=development
# Signs the session cookie. Any long random string. Required in production;
# defaults to an insecure value in development.
SESSION_SECRET=dev-insecure-secret

# --- Sign-in ---
# For a tool running on your own machine, this is the normal path: every
# request runs as this user id and the topbar reads "Dev session". Any string
# works on a fresh database.
DEV_AUTH_USER_ID=local
# Google sign-in, only needed if this is ever served to other people. Google
# Cloud console -> APIs & Services -> Credentials -> Create OAuth client ID ->
# Web application, redirect URI http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram (scraper alerts, optional) ---
# Bot token from @BotFather; chat id from @userinfobot or the bot's getUpdates.
# Point these at a fresh database and the first run treats every posting as
# new, so it will send the full cap of alerts at once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Adzuna (optional aggregator; needs API credentials) ---
# A licensed aggregator that indexes Naukri, Indeed, Monster and TimesJobs.
# Free registration at developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
