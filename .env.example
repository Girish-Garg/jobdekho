# JobDekho configuration. Copy to .env and edit. .env is gitignored and must
# stay that way. Every value here is a working local default except the
# credentials, which are blank, so an empty .env (or none at all) still brings
# `docker compose up --build` to a usable dashboard.

# --- Postgres container (docker-compose.yml) ---
# Credentials for the local Postgres. Change them before publishing DB_PORT to
# anything other than this machine.
POSTGRES_USER=jobdekho
POSTGRES_PASSWORD=jobdekho
POSTGRES_DB=jobdekho
# Host port the container's 5432 is published on. Change it if a Postgres of
# your own already owns 5432.
DB_PORT=5432

# --- Database, when running from the host ---
# Inside compose the app is pointed at the db service and this is ignored. It
# is for `npm start`, `npm run scrape`, `npm run db:migrate` and `npm run
# db:push` run on the host against the container above.
DATABASE_URL=postgres://jobdekho:jobdekho@localhost:5432/jobdekho

# --- Server ---
# Host port the dashboard is published on by compose.
APP_PORT=3000
# Port the server listens on when run from the host (compose pins 3000).
PORT=3000
BASE_URL=http://localhost:3000
# development keeps the session cookie usable over plain http://localhost and
# honours DEV_AUTH_USER_ID. production requires SESSION_SECRET and ignores
# the bypass, so it cannot be switched on by accident on a deployed box.
NODE_ENV=development
# Signs the session cookie. Any long random string. Required in production;
# defaults to an insecure value in development.
SESSION_SECRET=dev-insecure-secret

# --- Google OAuth (login) ---
# Google Cloud console -> APIs & Services -> Credentials -> Create OAuth
# client ID -> Web application. Authorized redirect URI:
# http://localhost:3000/auth/google/callback
# Leave blank to run without Google sign-in and use DEV_AUTH_USER_ID instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local-only sign-in bypass: every request runs as this user id and the
# topbar reads "Dev session". Any string works on a fresh database.
DEV_AUTH_USER_ID=

# --- Telegram (scraper alerts, optional) ---
# Bot token from @BotFather; chat id from @userinfobot or the bot's getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Adzuna (optional aggregator; needs API credentials) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
